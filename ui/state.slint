// The view model the title bar, Home and the account sheet draw from. src/slint_host/view.rs
// fills it from the core (`App`) after every batch of messages, setting only what changed, and
// turns its callbacks into core messages. Colours are named (`Ink`), never passed from Rust, so
// a theme switch recolours everything without a sync.
import { Theme } from "theme.slint";
import { Glyph, LampState } from "widgets.slint";

/// A named palette colour.
export enum Ink { ink, sub, faint, accent, ok, info, warn, danger, play-text, ok-tone, warn-tone, danger-tone }

/// The words that change only with the language.
export struct Strings {
    home: string,
    friends: string,
    downloads: string,
    settings: string,
    privacy: string,
    privacy-on-tip: string,
    privacy-off-tip: string,
    light-theme: string,
    dark-theme: string,
    /// The top bar's Discord button.
    discord: string,
    greeting: string,
    news: string,
    refresh-news: string,
    view-all-news: string,
    /// The news header's link (`.all`).
    all-news: string,
    /// The first-run section's heading.
    before-you-play: string,
    accounts: string,
    add-account: string,
    no-accounts: string,
    no-accounts-body: string,
    code: string,
    sign-in: string,
    look-up: string,
    open-website: string,
    wiki-title: string,
    wiki-placeholder: string,
    find-item: string,
    launch-with: string,
    // ---- the rail and the sky (v1.2) ----
    /// The greeting before any account is added.
    greeting-first: string,
    features: string,
    more: string,
    import-from-pol: string,
    nothing-picked: string,
    one-time-code: string,
    /// The Play button's key hint.
    enter: string,
}

/// A line of the rail's status block: what Crystal already knows (the Play state's detail, the
/// Windows components check).
export struct RailNote {
    glyph: Glyph,
    text: string,
    ink: Ink,
}

/// One news card.
export struct NewsCard {
    title: string,
    /// The whole headline, when `title` is elided (the tooltip and the accessible name).
    headline: string,
    teaser: string,
    kind: string,
    kind-ink: Ink,
    date: string,
    image: image,
    has-image: bool,
    /// A maintenance notice (wrench placeholder) rather than an article (feed placeholder).
    notice: bool,
    /// Its default picture when it has none (NewsArt): 0 update, 1 event, 2 maintenance,
    /// 3 community, 4 PlayOnline.
    art: int,
}

/// One check of Home's first-run section (no accounts yet): what it is, its state, and its one
/// action.
export struct SetupStep {
    glyph: Glyph,
    ink: Ink,
    title: string,
    body: string,
    /// A path or a count under the state, mono when `detail-mono`.
    detail: string,
    detail-mono: bool,
    action: string,
    action-glyph: Glyph,
    action-enabled: bool,
}

/// One account row.
export struct AccountLine {
    name: string,
    checked: bool,
    editing: bool,
    name-enabled: bool,
    ink: Ink,
    label: string,
    detail: string,
    /// The update's progress 0..1, or -1 for none.
    progress: float,
    percent: string,
    working: bool,
    otp: bool,
    otp-text: string,
    /// The code as the boxes draw it (bullets in privacy mode), and its length.
    otp-shown: string,
    otp-len: int,
    action: string,
    action-soft: bool,
    action-enabled: bool,
    /// This row is being dragged to a new place.
    dragging: bool,
    /// The crystal lamp, and how far it has risen while signing in (0..1).
    lamp: LampState,
    fill: float,
    /// The session clock while in game ("3h 12m").
    clock: string,
    /// Your PlayOnline portrait (the silhouette in privacy mode), once a session reported it.
    picture: image,
    has-picture: bool,
}

/// The rail's status block and Play button (the former footer play bar). The status's detail is
/// the first of View.notes.
export struct Footer {
    status: string,
    /// 0 ready (dot), 1 attention (amber dot), 2 busy (ring), 3 unchecked (faint dot), 4 nothing
    /// to play yet (info glyph).
    badge: int,
    shutdown: bool,
    shutdown-busy: bool,
    shutdown-enabled: bool,
    shutdown-label: string,
    launch-current: int,
    play-label: string,
    /// 0 triangle, 1 check, 2 busy, 3 download, 4 wrench, 5 alert.
    play-glyph: int,
    play-ink: Ink,
    /// 0 the Play fill, 1 the attention fill, 2 tint, 3 the ok fill.
    play-fill: int,
    play-enabled: bool,
    /// Who Play starts ("" when nothing is picked).
    names: string,
}

/// The account sheet's words that change only with the language.
export struct SheetStrings {
    account: string,
    launch: string,
    status: string,
    after-adding: string,
    display-name: string,
    display-placeholder: string,
    private-note: string,
    hairpin: string,
    hairpin-note: string,
    server: string,
    server-placeholder: string,
    show: string,
    hide: string,
    change: string,
    se-id: string,
    se-id-placeholder: string,
    se-password: string,
    password-placeholder: string,
    pol-password-placeholder: string,
    region: string,
    region-note: string,
    uses-otp: string,
    totp-key: string,
    totp-key-placeholder: string,
    totp-key-note: string,
    handles: string,
    handles-placeholder: string,
    handles-note: string,
    saved-note: string,
    launch-with: string,
    auto-login: string,
    slot: string,
    slot-note: string,
    folder: string,
    folder-placeholder: string,
    folder-note: string,
    active-note: string,
    last-play: string,
    view-log: string,
    open-logs: string,
    sign-out: string,
    sign-in-now: string,
    delete: string,
    cancel: string,
    edit-profiles: string,
    close: string,
    portrait: string,
}

/// The account sheet's state.
export struct Sheet {
    editing: bool,
    caption: string,
    title: string,
    retail: bool,
    active: bool,
    label-masked: bool,
    id-label: string,
    id-placeholder: string,
    id-masked: bool,
    id-button: string,
    password-label: string,
    password-masked: bool,
    password-enabled: bool,
    password-button: string,
    se-id-masked: bool,
    handles-masked: bool,
    region: int,
    /// The installed PlayOnline is another edition ("" when it matches), and the fix button's
    /// label ("" when no single edition to set) and region.
    region-mismatch: string,
    region-fix: string,
    region-fix-index: int,
    uses-otp: bool,
    /// The authenticator key field: masked unless shown (always in privacy mode), and on a saved
    /// account that has a key, read-only until Change, like the password.
    totp-key-masked: bool,
    totp-key-enabled: bool,
    totp-key-button: string,
    launch-index: int,
    launch-hint: string,
    /// 0 no tool field, 1 Ashita boot config, 2 Windower profile.
    tool: int,
    tool-label: string,
    tool-current: int,
    tool-note: string,
    edit-profiles-enabled: bool,
    /// Private-server accounts: xiloader gets --hairpin.
    hairpin: bool,
    auto-login: bool,
    slot: int,
    folder-masked: bool,
    folder-enabled: bool,
    browse-enabled: bool,
    has-status: bool,
    status-ink: Ink,
    status-label: string,
    status-detail: string,
    sign-out-enabled: bool,
    timing: string,
    has-log: bool,
    log-enabled: bool,
    after-adding: bool,
    sign-in-now: bool,
    sign-in-now-enabled: bool,
    sign-in-note: string,
    app-status: string,
    delete-enabled: bool,
    save-label: string,
    save-enabled: bool,
    /// A saved retail account: its PlayOnline portrait row (the picture once a session reported
    /// it, the silhouette in privacy mode) and the picker button.
    portrait-shown: bool,
    picture: image,
    has-picture: bool,
}

export global View {
    // ---- shell ----
    in property <Strings> strings;
    /// 0 Home, 1 Friends, 2 Downloads, 3 Settings.
    in property <int> page;
    /// The Friends tab's count badge ("" hides it).
    in property <string> friends-badge;
    in property <bool> privacy;
    callback navigate(int);
    callback toggle-privacy();
    callback toggle-theme();
    /// Open the Crystal Discord's invite in the browser.
    callback open-discord();

    // ---- hero (the clock is the Sky global's) ----
    /// Japanese keeps the interface face upright (Source Serif has no Japanese).
    in property <bool> serif-greeting: true;

    // ---- Windows components banner ----
    in property <bool> banner;
    in property <string> banner-lead;
    in property <string> banner-rest;
    in property <string> banner-action;
    in property <bool> banner-restart;
    callback banner-clicked();

    // ---- news ----
    in property <string> news-note;
    in property <[string]> news-tabs;
    in property <int> news-tab;
    /// The large cards (three, two in the small window).
    in property <[NewsCard]> news;
    /// The older headlines under them, one line each; `open-news` numbers them after the cards.
    in property <[NewsCard]> news-older;
    /// 0 cards, 1 loading, 2 unavailable, 3 nothing in this tab.
    in property <int> news-state;
    in property <string> news-empty-title;
    in property <string> news-empty-body;
    callback news-picked(int);
    callback refresh-news();
    callback view-all-news();
    callback open-news(int);

    // ---- first run (no accounts yet) ----
    in property <bool> first-run;
    /// Why the saved accounts could not be read; empty when they were (or are still loading).
    in property <string> vault-error;
    in property <[SetupStep]> setup;
    callback setup-action(int);

    // ---- accounts ----
    in property <string> accounts-note;
    in property <bool> can-add;
    in property <[AccountLine]> accounts;
    callback toggle-account(int, bool);
    callback edit-account(int);
    callback otp-edited(int, string);
    callback row-action(int);
    callback import-accounts();
    callback add-account();

    // ---- look up ----
    in-out property <string> wiki-query;
    in-out property <string> ah-query;
    in property <[string]> ah-servers;
    in property <int> ah-server;
    /// The look-up bar's site: 0 the wiki, 1 FFXIAH (with its world picker).
    in-out property <int> look-scope: 1;
    /// Whether Home shows the look-up bar (Settings → System → Item and wiki search).
    in property <bool> look-up: true;
    callback wiki-edited(string);
    callback wiki-search();
    callback ah-edited(string);
    callback ah-search();
    callback ah-server-picked(int);
    callback open-wiki();
    callback open-ffxiah();

    // ---- the rail's status block and Play (the former footer) ----
    in property <Footer> footer;
    /// The lines under the status line.
    in property <[RailNote]> notes;
    /// The rail's More menu, and its pick (view.rs keeps what each entry does).
    in property <[string]> rail-menu;
    callback rail-menu-picked(int);
    in property <[string]> launch-items;
    in property <string> mixed;
    callback toggle-details();
    callback launch-picked(int);
    callback shut-down-selected();
    callback main-action();

    // ---- account order ----
    /// A row is being dragged (app.account_drag).
    in property <bool> dragging;
    /// The pointer's window y while a row is dragged (the grip holds the pointer, so the rows
    /// see no hover of their own).
    in-out property <length> drag-y;
    /// A row's grip was pressed / the dragged pointer is over a row.
    callback drag-start(int);
    callback drag-over(int);

    // ---- account sheet ----
    in property <bool> sheet-open;
    in property <SheetStrings> sheet-strings;
    in property <Sheet> sheet;
    in property <[string]> regions;
    in property <[string]> launch-choices;
    /// A private-server account's Launch with: xiloader, Windower, Ashita.
    in property <[string]> private-launch-choices;
    in property <[string]> tool-items;
    in property <[string]> slot-items;
    in-out property <string> sheet-label;
    in-out property <string> sheet-server;
    in-out property <string> sheet-pol-id;
    in-out property <string> sheet-pol-password;
    in-out property <string> sheet-se-id;
    in-out property <string> sheet-se-password;
    in-out property <string> sheet-handles;
    in-out property <string> sheet-totp-key;
    in-out property <string> sheet-folder;
    callback close-sheet();
    callback save-sheet();
    /// A field changed: 0 label, 1 server, 2 PlayOnline ID, 3 password, 4 Square Enix ID,
    /// 5 Square Enix password, 6 handle names, 7 authenticator key (crate::Field's order).
    callback sheet-edited(int, string);
    callback sheet-folder-edited(string);
    callback sheet-region(int);
    callback sheet-launch(int);
    /// crate::EditorFlag's order: uses OTP, sign in now, show ID, show password, change password,
    /// show authenticator key, change authenticator key, no hairpin.
    callback sheet-flag(int, bool);
    callback sheet-auto-login(bool);
    callback sheet-slot(int);
    callback sheet-tool(int);
    callback edit-profiles();
    callback browse-folder();
    callback sign-out();
    callback view-log();
    callback open-logs();
    callback delete-account();
    callback choose-portrait();

    public pure function tone(which: Ink) -> color {
        which == Ink.ink ? Theme.ink
            : which == Ink.sub ? Theme.sub
            : which == Ink.faint ? Theme.faint
            : which == Ink.accent ? Theme.accent
            : which == Ink.ok ? Theme.ok
            : which == Ink.info ? Theme.info
            : which == Ink.warn ? Theme.warn
            : which == Ink.danger ? Theme.danger
            : which == Ink.ok-tone ? Theme.ok-tone
            : which == Ink.warn-tone ? Theme.warn-tone
            : which == Ink.danger-tone ? Theme.danger-tone
            : Theme.play-text
    }
}

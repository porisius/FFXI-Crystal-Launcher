// The Settings page (the two panes of a-skyline\features-dark.png): the page header with Privacy
// mode and the language, a tile per tab with its state, and the selected tab's cards in the
// detail scroller.
import { Theme } from "theme.slint";
import { SettingsView } from "settings_state.slint";
import { Select, Toggle, ScrollThumb, TipBody, Glyph } from "widgets.slint";
import { SectionTile, PageTitle, DetailTitle } from "panes.slint";
import { SystemTab } from "settings_system.slint";
import { GraphicsTab, GameOptions } from "settings_graphics.slint";
import { ControllerTab } from "settings_controller.slint";
import { ServerTab } from "settings_server.slint";

export { SettingsView }

export component SettingsPage inherits Rectangle {
    private property <float> s: Theme.scale;
    VerticalLayout {
        padding-top: Theme.sp-3;
        padding-left: Theme.page-x;
        padding-right: Theme.page-x;
        spacing: Theme.sp-xl;
        // Privacy mode and the language apply to every page, not to one tab.
        HorizontalLayout {
            height: Theme.control-h;
            spacing: Theme.sp-l;
            PageTitle {
                cross-axis-self-alignment: start;
                horizontal-stretch: 1;
                text: SettingsView.strings.title;
            }
            privacy := Toggle {
                cross-axis-self-alignment: center;
                horizontal-stretch: 0;
                size: 20px;
                gap: 10px;
                font-size: Theme.type-small;
                ink: Theme.sub;
                text: SettingsView.strings.privacy;
                on: SettingsView.system.privacy;
                toggled(on) => { SettingsView.set-privacy(on); }
                Tooltip { TipBody { text: SettingsView.strings.privacy-tip; } }
            }
            Rectangle { width: Theme.sp-s; horizontal-stretch: 0; }
            Text {
                horizontal-stretch: 0;
                text: SettingsView.strings.language;
                font-size: Theme.type-small;
                color: Theme.sub;
                vertical-alignment: center;
            }
            Select {
                cross-axis-self-alignment: center;
                horizontal-stretch: 0;
                width: 150px;
                label: SettingsView.strings.language;
                items: SettingsView.languages;
                current: SettingsView.system.language;
                picked(index) => { SettingsView.set-language(index); }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.small ? 28px : Theme.page-x;
            VerticalLayout {
                horizontal-stretch: 0;
                width: Theme.small ? 232px : 288px;
                spacing: 4px;
                alignment: start;
                // Titles alone: each tab's state is on its page (the apply bar, the device card,
                // the updates card), and a note on some tiles only made the list jump.
                for tab[i] in SettingsView.tabs: SectionTile {
                    glyph: i == 0 ? Glyph.monitor : i == 1 ? Glyph.speaker : i == 2 ? Glyph.gamepad : Glyph.cpu;
                    title: tab;
                    active: i == SettingsView.tab;
                    clicked => { SettingsView.pick-tab(i); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                page := Flickable {
                    // Its width comes from the page alone: its content (whose columns are sized from
                    // that width) must not feed back into it.
                    min-width: 0px;
                    preferred-width: 0px;
                    max-width: 100000px;
                    content-width: self.width;
                    content-height: body.preferred-height;
                    body := VerticalLayout {
                        width: page.width;
                        height: self.preferred-height;
                        padding-right: 12px;
                        padding-bottom: Theme.sp-2xl;
                        spacing: Theme.sp-l;
                        alignment: start;
                        DetailTitle { text: SettingsView.tabs[SettingsView.tab]; }
                        if SettingsView.tab == 0: GraphicsTab { width-hint: page.width - 12px; }
                        if SettingsView.tab == 1: GameOptions { width-hint: page.width - 12px; }
                        if SettingsView.tab == 2: ControllerTab { width-hint: page.width - 12px; }
                        if SettingsView.tab == 3: SystemTab { }
                        if SettingsView.tab == 4: ServerTab { }
                    }
                }
                ScrollThumb {
                    x: parent.width - 4px;
                    height: parent.height;
                    content-y: page.content-y;
                    content-height: page.content-height;
                    visible-height: page.height;
                }
            }
        }
    }
}
